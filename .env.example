# ============================================================
# Urban Subsidence Watcher — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# ASF Vertex API (Sentinel-1 downloads)
# Register at: https://urs.earthdata.nasa.gov/users/new
ASF_USERNAME=your_asf_username
ASF_PASSWORD=your_asf_password

# Copernicus Open Access Hub (alternative S1 source)
# Register at: https://scihub.copernicus.eu/dhus/#/self-registration
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# NASA Earthdata (for SRTM DEM via OpenTopography)
# Register at: https://urs.earthdata.nasa.gov/users/new
NASA_EARTHDATA_USER=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# OpenTopography API Key (optional, for higher-res DEMs)
# Register at: https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key

# Optional: Weights & Biases for experiment tracking
# WANDB_API_KEY=your_wandb_api_key
# WANDB_PROJECT=urban-subsidence-watcher
